{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boggersthefish.com/schemas/benchmark_receipt.schema.json",
  "title": "TS Benchmark Receipt",
  "type": "object",
  "required": [
    "receipt_id",
    "timestamp_utc",
    "repo",
    "branch",
    "commit",
    "machine",
    "dependencies",
    "dataset",
    "system",
    "model",
    "seed",
    "config",
    "command",
    "metrics",
    "failure_cases",
    "logs_path",
    "artifacts"
  ],
  "properties": {
    "receipt_id": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "repo": {"type": "string"},
    "branch": {"type": "string"},
    "commit": {"type": "string"},
    "machine": {
      "type": "object",
      "required": ["hostname_hash", "cpu", "platform", "python_version"],
      "properties": {
        "hostname_hash": {"type": "string"},
        "cpu": {"type": "string"},
        "platform": {"type": "string"},
        "ram_gb": {"type": ["number", "null"]},
        "gpu": {"type": ["string", "null"]},
        "cuda_version": {"type": ["string", "null"]},
        "python_version": {"type": "string"}
      }
    },
    "dependencies": {"type": "object"},
    "dataset": {
      "type": "object",
      "required": ["name", "version", "hash"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "hash": {"type": "string"}
      }
    },
    "system": {
      "type": "object",
      "required": ["name", "variant"],
      "properties": {
        "name": {"type": "string"},
        "variant": {"type": "string"}
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "hash"],
      "properties": {
        "name": {"type": "string"},
        "hash": {"type": ["string", "null"]}
      }
    },
    "seed": {"type": "integer"},
    "config": {"type": "object"},
    "command": {"type": "string"},
    "metrics": {"type": "object"},
    "failure_cases": {"type": "array"},
    "logs_path": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string"}
        }
      }
    }
  }
}
